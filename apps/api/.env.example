# Copy to apps/api/.env and edit. Everything is optional — the app runs with no config.

# --- AI brain -------------------------------------------------------------
# Set ONE of these keys and that LLM drives the LangGraph agent.
# With no key, a deterministic built-in policy drives the same graph & tools.

# Gemini (Google AI Studio key, via langchain-google-genai)
# GEMINI_API_KEY=your-gemini-key
# LEADFLOW_GEMINI_MODEL=gemini-3.5-flash
# LEADFLOW_GEMINI_THINKING_LEVEL=low   # minimal | low | medium | high
# LEADFLOW_GEMINI_FALLBACK_MODEL=gemini-flash-latest   # tried when the main model is overloaded

# Claude (via langchain-anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# LEADFLOW_ANTHROPIC_MODEL=claude-opus-5

# If both keys are set, "auto" prefers Claude. Force one with: anthropic | gemini | none
# LEADFLOW_LLM_PROVIDER=auto

# --- Database -------------------------------------------------------------
# Default: SQLite file at apps/api/leadflow.db
# LEADFLOW_DATABASE_URL=postgresql+asyncpg://leadflow:leadflow@localhost:5432/leadflow
# Seed 16 demo leads (run through the real agent) when the database is empty.
# LEADFLOW_SEED_DEMO_DATA=true

# --- Business rules -------------------------------------------------------
# LEADFLOW_COMPANY_NAME=LeadFlow AI
# LEADFLOW_BUSINESS_TIMEZONE=Asia/Kolkata
# LEADFLOW_BUSINESS_START_HOUR=9
# LEADFLOW_BUSINESS_END_HOUR=17
# LEADFLOW_MEETING_MINUTES=30
# LEADFLOW_QUALIFIED_SCORE=60

# --- Email (optional) -----------------------------------------------------
# Without SMTP, emails are recorded in the outbox as "simulated".
# LEADFLOW_SMTP_HOST=smtp.example.com
# LEADFLOW_SMTP_PORT=587
# LEADFLOW_SMTP_USERNAME=
# LEADFLOW_SMTP_PASSWORD=
# LEADFLOW_SMTP_FROM=LeadFlow AI <agent@yourdomain.com>

# --- Server ---------------------------------------------------------------
# LEADFLOW_HOST=127.0.0.1
# LEADFLOW_PORT=8000
# LEADFLOW_RELOAD=false
# LEADFLOW_CORS_ORIGINS=["http://localhost:5173"]
